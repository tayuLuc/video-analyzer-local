# Video Analyzer Web - Environment Configuration
# Copy this file to .env and fill in your values

# ============== Endpoint ==============
# Any server speaking the OpenAI /v1 API. Inside Docker, "host.docker.internal"
# reaches the host machine.
#   LiteLLM proxy  :4000/v1   (richest: reports per-model vision support)
#   vLLM           :8000/v1
#   llama.cpp      :8080/v1
#   Ollama         :11434/v1
OPENAI_BASE_URL=http://host.docker.internal:4000/v1

# Optional. Local servers usually need no key; set one only if the endpoint
# rejects anonymous calls, or enter it in the web interface at runtime.
OPENAI_API_KEY=

# Optional. Preselected in the model dropdown when the endpoint reports it.
# Leave empty to take whatever the server lists, first row wins.
OPENAI_MODEL_NAME=

# ============== Processing Settings ==============
# Maximum duration of each video chunk in minutes
CHUNK_DURATION_MINUTES=10

# Chunk splitting mode:
# - fixed: split strictly by CHUNK_DURATION_MINUTES
# - silence_aware: move split points to nearby silence windows
CHUNK_SPLIT_MODE=fixed

# Silence-aware splitting settings (used only when CHUNK_SPLIT_MODE=silence_aware)
# Search window around target split point in seconds (e.g. 120 = +/- 2 min)
SILENCE_WINDOW_SECONDS=120

# Minimum silence duration to qualify as split candidate (seconds)
SILENCE_MIN_DURATION_SECONDS=3.0

# Silence threshold in dB (higher, e.g. -30, is less strict; lower, e.g. -40, is stricter)
SILENCE_NOISE_DB=-35.0

# Maximum upload file size in MB (0 = no application limit)
MAX_UPLOAD_SIZE_MB=0
